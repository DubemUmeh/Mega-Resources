# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Admin auth/session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Optional alias if you prefer Better Auth-style env naming; AUTH_SECRET takes priority.
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth + Gmail API
# Redirect URI in Google Cloud Console: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Cloudinary uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Optional SMTP notifications
BREVO_SMTP_USER="your-brevo-smtp-user"
BREVO_SMTP_PASSWORD="your-brevo-smtp-password"

# Public form protection (Cloudflare Turnstile Managed mode)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFSUBsVM8ZcqtmaK
TURNSTILE_SECRET=
# Production: www.megaresourcesgh.com,megaresourcesgh.com
# Local development: localhost,127.0.0.1
TURNSTILE_HOSTNAMES=www.megaresourcesgh.com,megaresourcesgh.com
